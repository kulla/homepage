{
  "name": "homepage",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/index.html --outdir dist --target browser --minify",
    "check:format": "prettier --check .",
    "check:tsc": "tsc --noEmit",
    "dev": "bun --hot src/index.html",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.12",
    "prettier": "3.8.3",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "modern-normalize": "3.0.1"
  }
}
