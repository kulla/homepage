---
const base = import.meta.env.BASE_URL
---

<button
  id="burger-menu"
  class="svg-button"
  type="button"
  aria-expanded="false"
  aria-controls="main-menu"
  aria-label="Open menu"
>
  <svg
    viewBox="0 0 24 24"
    width="24"
    height="24"
    stroke="currentColor"
    stroke-width="2"
    fill="none"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <line x1="3" y1="12" x2="21" y2="12"></line>
    <line x1="3" y1="6" x2="21" y2="6"></line>
    <line x1="3" y1="18" x2="21" y2="18"></line>
  </svg>
</button>

<div id="main-menu" class="navigation">
  <button class="menu-close svg-button" type="button" aria-label="Close menu">
    <svg
      viewBox="0 0 24 24"
      width="24"
      height="24"
      stroke="currentColor"
      stroke-width="2"
      fill="none"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <div class="nav-links">
    <a href={base}>Home</a>
    <a href={`${base}blog/`}>Blog</a>
    <a href={`${base}cv/`}>CV</a>
  </div>
</div>

<script>
  const toggle = document.getElementById('burger-menu')
  const closeBtn = document.querySelector('.menu-close')
  const nav = document.querySelector('.navigation')

  const isElement = (value) => value instanceof Element

  const closeMenu = () => toggle?.setAttribute('aria-expanded', 'false')

  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true'
    toggle.setAttribute('aria-expanded', String(!isExpanded))
  })

  closeBtn?.addEventListener('click', closeMenu)

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu)
  })

  document.addEventListener('click', (event) => {
    if (!isElement(event.target)) {
      return
    }

    const isClickInsideMenu = event.target.closest('.navigation')
    const isClickOnToggle = event.target.closest('#burger-menu')

    if (
      !isClickInsideMenu &&
      !isClickOnToggle &&
      toggle?.getAttribute('aria-expanded') === 'true'
    ) {
      closeMenu()
    }
  })
</script>

<style>
  #burger-menu {
    padding: 1rem;
  }

  .menu-close {
    padding: 1rem;
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 1000;
    transition: transform var(--transition-fast);
  }

  .navigation {
    position: fixed;
    top: 0;
    left: -100%;
    width: 80%;
    max-width: 300px;
    height: 100%;
    background-color: var(--color-bg);
    z-index: 999;
    transition: left var(--transition-standard);
    display: flex;
    flex-direction: column;
    padding-top: 4rem;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
  }

  #burger-menu[aria-expanded='true'] ~ .navigation {
    left: 0;
  }

  :global(body):has(#burger-menu[aria-expanded='true'])::before {
    content: '';
    position: fixed;
    inset: 0;
    background-color: rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 998;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
  }

  .nav-links a {
    color: var(--color-primary);
    text-decoration: none;
    padding: 1.25rem 2rem;
    font-size: 1.1rem;
    font-weight: 200;
    transition: all var(--transition-fast);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  @media (hover: hover) {
    .nav-links a:hover {
      background-color: rgba(0, 0, 0, 0.03);
      padding-left: 2.5rem;
      color: var(--color-accent);
    }
  }

  .nav-links a:active {
    background-color: rgba(0, 0, 0, 0.03);
    padding-left: 2.5rem;
    color: var(--color-accent);
  }

  @media screen and (min-width: 636px) {
    #burger-menu {
      display: none;
    }

    .menu-close {
      display: none;
    }

    :global(body):has(#burger-menu[aria-expanded='true'])::before {
      display: none;
    }

    .navigation {
      position: static;
      left: 0;
      width: auto;
      max-width: none;
      height: auto;
      background: none;
      box-shadow: none;
      padding-top: 0;
      display: block;
      z-index: auto;
    }

    .nav-links {
      flex-direction: row;
      background: none;
    }

    .nav-links a {
      color: var(--color-primary);
      padding: 0.5rem 1rem;
      border-bottom: none;
      font-size: 1rem;
    }

    @media (hover: hover) {
      .nav-links a:hover {
        background: none;
        padding-left: 1rem;
        color: var(--color-accent);
      }
    }

    .nav-links a:active {
      background: none;
      padding-left: 1rem;
      color: var(--color-accent);
    }
  }
</style>
